# Required — the chat agent's brain (Claude tool-use loop)
ANTHROPIC_API_KEY=
# Optional — default claude-sonnet-4-6
ANTHROPIC_MODEL=

# Voice + phone (ElevenLabs Conversational AI). Optional; chat works without them.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# Shared secret the ElevenLabs agent sends on every webhook tool call.
# Generate one: openssl rand -hex 32  — set the SAME value here and in the deployed app.
AGENT_TOOLS_SECRET=

# Optional — cross-instance live feed on Vercel (Upstash Redis / Vercel KV).
# Without it the live panel uses an in-process bus (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
